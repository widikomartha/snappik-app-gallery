{
  "name": "snappik",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:auth": "playwright test --config playwright.auth.config.ts",
    "test:browser:projects": "playwright test --config playwright.projects.config.ts",
    "test:browser:selection": "playwright test --config playwright.selection.config.ts",
    "test:browser:progress": "playwright test --config playwright.progress.config.ts",
    "test:browser:delivery": "playwright test --config playwright.delivery.config.ts",
    "test:browser:archives": "playwright test --config playwright.archives.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/raleway": "^5.2.0",
    "@inertiajs/react": "^3.9.1",
    "motion": "^14.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.0.0",
    "laravel-vite-plugin": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
