APP_NAME=SnapPik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snappik
DB_USERNAME=snappik
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Local HTTP only. Production always forces secure cookies.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
# Local account mail stays in memory. Use AUTH_MAILER=smtp for an authorized sender.
# Account mail rejects log/failover transports so secret links cannot enter logs.
AUTH_MAILER=array
MAIL_MAILER=array
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME=SnapPik
VITE_APP_NAME=SnapPik

# Drive originals and TASK-002/TASK-008 private temporary ZIP storage.
# DRIVE_PROOF_FOLDER_URL is used only by the local/test proof command.
# Restricted server API key with Drive API enabled; never use reference credentials.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_REQUEST_INTERVAL_MS=1000
DRIVE_PROOF_FOLDER_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ARCHIVE_BUCKET=

# Midtrans sandbox only; leave empty until a test merchant is configured.
MIDTRANS_SANDBOX_MERCHANT_ID=
MIDTRANS_SANDBOX_SERVER_KEY=
MIDTRANS_QRIS_MINIMUM_IDR=1

# Release preparation: keep disabled/unset locally. Never paste secrets into evidence records.
SNAPPIK_RELEASE_COMMIT=
SNAPPIK_TERMS_URL=
SNAPPIK_PRIVACY_URL=
SNAPPIK_SUPPORT_URL=
# Authorized SMTP sender only; no mail is sent by release-check.
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# Daily 02:00 UTC backup; enable only after configuring an independent PRIVATE bucket,
# lifecycle retention and tested independent private-key custody. App host holds public key only.
SNAPPIK_BACKUP_ENABLED=false
SNAPPIK_BACKUP_BASH=/bin/bash
SNAPPIK_PG_DUMP=/usr/bin/pg_dump
SNAPPIK_GPG=/usr/bin/gpg
SNAPPIK_BACKUP_GPG_HOME=
SNAPPIK_BACKUP_RECIPIENT=
R2_BACKUP_ACCOUNT_ID=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
